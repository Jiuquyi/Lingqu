diff --git a/k8s/jiuquyi/machgate/groups.toml b/k8s/jiuquyi/machgate/groups.toml
index 1bac64f..ba1bda5 100644
--- a/k8s/jiuquyi/machgate/groups.toml
+++ b/k8s/jiuquyi/machgate/groups.toml
@@ -134,3 +134,20 @@ hourly_usd = { claude = 100 }
 via_lingqu = true
 limiter = "lingqu"
 dashboard_port = 3603
+
+# Integrated Lingqu usage dashboard; read credentials are injected by the Deployment.
+[lingqu.usage]
+enabled = true
+scope = "managed"
+retention_days = 90
+max_records = 100000
+timezone = "Asia/Shanghai"
+title = "用量分析"
+cost_label = "计费金额"
+cost_hint = "按售价计费"
+cost_note = "金额是 New API 按售价向用户计的费（含分组倍率），只统计经订阅渠道（sub、sub2、sub3）的请求；DeepSeek、国模等手工渠道不在内。 灵渠限额卡片使用折算费用 eUSD。"
+
+[lingqu.usage.newapi]
+base_url = "http://new-api:3000"
+token = "${NEWAPI_ACCESS_TOKEN}"
+user_id = "${NEWAPI_USER_ID}"
diff --git a/k8s/jiuquyi/machgate/machgate.py b/k8s/jiuquyi/machgate/machgate.py
index 54700da..24fa475 100644
--- a/k8s/jiuquyi/machgate/machgate.py
+++ b/k8s/jiuquyi/machgate/machgate.py
@@ -870,5 +870,9 @@ def render_lingqu(cfg, env, options, discovered):
         "pools": pools,
         "notify": {"webhook": "", "throttle_events": True},
     }
+    # Optional built-in Lingqu usage dashboard. Keep environment references intact;
+    # the Lingqu container receives only the New API read credentials it needs.
+    if "usage" in lq:
+        conf["usage"] = lq["usage"]
     return ("# Generated by scripts/machgate.py from config/groups.toml and New API's prices; do not edit.\n"
             + json.dumps(conf, indent=2, ensure_ascii=False) + "\n")
